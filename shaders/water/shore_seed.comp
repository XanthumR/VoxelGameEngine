#version 440 core
// Shore map pass 1 of 3 (ShoreMap, src/Rendering/ShoreMap.cpp): classify columns as land or water at sea level.

#include "include/scene.glsl"
#include "include/voxel_data.glsl"
#include "include/water.glsl"

// Classifies each column at sea level: land seeds the "nearest land" channel, water seeds the
// "nearest water" channel and records how deep it is
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32i, binding = 5) uniform writeonly iimage2D seeds; // xy = nearest land, zw = nearest water
layout(r32f, binding = 6) uniform writeonly image2D depthMap;

const int NO_SEED = -1000000;
const int MAX_DEPTH = 24;

// Figures (people, smoke, boats: block IDs 47-59, see FigureRenderer) come and go; a boat in the
// sea must not count as land, or surf would form around wherever it was at the last rebuild
const int FIGURE_FIRST = 47;
const int FIGURE_LAST = 59;
const int SMOKE_DARK = 182;

bool isWaterVoxel(ivec3 p) {
    int id = int(getVoxelVal(p) * 255.0 + 0.5);
    return id == WATER_ID || (id >= FIGURE_FIRST && id <= FIGURE_LAST) || id == SMOKE_DARK;
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 column = shoreOrigin + texel;
    bool water = isWaterVoxel(ivec3(column.x, seaLevel, column.y));

    float depth = 0.0;
    if (water) {
        int y = seaLevel - 1;
        while (y > seaLevel - MAX_DEPTH && isWaterVoxel(ivec3(column.x, y, column.y))) y--;
        depth = float(seaLevel - y);
    }

    imageStore(seeds, texel, water ? ivec4(NO_SEED, NO_SEED, texel) : ivec4(texel, NO_SEED, NO_SEED));
    imageStore(depthMap, texel, vec4(depth));
}
