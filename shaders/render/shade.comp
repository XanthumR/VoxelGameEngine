#version 440 core
// Render pass 3 of 3 (VoxelRenderer): per-pixel lighting from the G-buffer (block colors, sun
// and soft shadows, water, glows) and the sky. Writes the final image that is blitted to the
// window.
// The crosshair and hotbar are drawn separately by ImGui (src/UI/Hud.cpp).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "include/scene.glsl"
#include "include/voxel_data.glsl"
#include "include/water.glsl"
#include "include/gbuffer.glsl"
#include "include/camera.glsl"
#include "include/lighting.glsl"

layout(rgba32i, binding = 2) uniform readonly iimage2D gBuffer;
layout(r32f, binding = 3) uniform readonly image2D shadowValue;
layout(rgba32i, binding = 4) uniform readonly iimage2D shadowKey;
layout(rgba32f, binding = 0) uniform writeonly image2D imgOutput;

// Build preview box (BuildPreview in src/Rendering/BuildPreview.h)
uniform int previewState; // 0 = none, 1 = valid (green), 2 = invalid (red), 3 = selected building (yellow)
uniform ivec3 previewMin; // Voxels, inclusive
uniform ivec3 previewMax; // Voxels, exclusive

// Per build tile ground highlights (TileOverlay in src/Rendering/TileOverlay.h)
layout(binding = 13) uniform usampler2D tileOverlay;
uniform ivec2 overlayOrigin; // Tile of texel (0, 0)
uniform int overlayGroundY;  // Highlights tint the top faces of the voxel layer just below this
const int TILE_OVERLAY_SIZE = 256;
uniform int overlayTileSize; // Columns per tile (TILE_SIZE)

// Palette of TileOverlay::Color: rgb and blend strength
vec4 tileOverlayColor(uint index) {
    if (index == 1u) return vec4(0.20, 0.50, 1.00, 0.60); // Road in range
    if (index == 2u) return vec4(0.55, 0.55, 0.55, 0.45); // Road out of range
    if (index == 3u) return vec4(0.20, 1.00, 0.30, 0.55); // Preview: add
    if (index == 4u) return vec4(1.00, 0.25, 0.20, 0.55); // Preview: invalid
    if (index == 5u) return vec4(1.00, 0.55, 0.10, 0.55); // Preview: remove
    if (index == 6u) return vec4(0.20, 0.75, 1.00, 0.70); // Warehouse reach
    if (index == 7u) return vec4(1.00, 0.70, 0.20, 0.55); // Road in a marketplace's reach
    if (index == 8u) return vec4(1.00, 0.80, 0.10, 0.75); // Marketplace reach
    if (index == 9u) return vec4(0.75, 1.00, 0.45, 0.45); // Pasture or trees a producer counts
    return vec4(0.0);
}

// Generates a pseudo-random float between 0.0 and 1.0 based on pixel coordinates
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

vec3 getFalseColor(float level) {
    float t = clamp(level / 15.0, 0.0, 1.0);
    vec3 c = vec3(0.0);
    if (t < 0.25) {
        c = mix(vec3(0.2, 0.0, 0.3), vec3(0.0, 0.0, 1.0), t / 0.25);
    } else if (t < 0.5) {
        c = mix(vec3(0.0, 0.0, 1.0), vec3(0.0, 1.0, 0.0), (t - 0.25) / 0.25);
    } else if (t < 0.75) {
        c = mix(vec3(0.0, 1.0, 0.0), vec3(1.0, 1.0, 0.0), (t - 0.5) / 0.25);
    } else {
        c = mix(vec3(1.0, 1.0, 0.0), vec3(1.0, 0.0, 0.0), (t - 0.75) / 0.25);
    }
    return c;
}

