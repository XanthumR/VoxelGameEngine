    else if (voxelID == 59) albedo = vec3(0.42, 0.28, 0.16); // Boat wood
    else if (voxelID == 45) albedo = hash(vec2(mapPos.xz) * 1.3) >= 0.5 ? vec3(0.50, 0.48, 0.44) : vec3(0.42, 0.40, 0.37); // Road kerb stones
    else if (voxelID == 44) albedo = mix(vec3(0.36, 0.27, 0.17), vec3(0.44, 0.33, 0.21), hash(vec2(mapPos.xz) * 0.73)); // Dirt road
    else if (voxelID == 43) albedo = hash(vec2(mapPos.xz) + float(mapPos.y) * 3.0) >= 0.5 ? vec3(0.70, 0.66, 0.58) : vec3(0.62, 0.58, 0.51); // Masonry
    else if (voxelID == 34) albedo = mix(vec3(0.12, 0.55, 0.05), vec3(0.30, 0.85, 0.12), hash(vec2(mapPos.xz) + float(mapPos.y) * 7.0)); // Grass tuft
    return albedo;
}

// Shadow for a hit face: reuses a half-resolution sample from this pixel's own quad or the
// 3 neighbouring quads when one was computed for the same face plane (same normal, same
// plane offset, within 2 voxels). Shadows are constant per voxel face, so this only moves
// shadow edges by at most a render pixel. Falls back to tracing its own rays otherwise.
float lookupShadow(ivec2 pixel, ivec3 mapPos, int normalIndex, vec3 normal) {
    if (dot(normal, lightDir) <= 0.0) return 0.3; // Back face, same shortcut as softShadow
    if (halfResShadows == 0) return softShadow(mapPos, normal);

    ivec2 quadDims = (renderSize + 1) / 2;
    ivec2 quad = pixel / 2;
    ivec2 toward = ivec2((pixel.x & 1) == 0 ? -1 : 1, (pixel.y & 1) == 0 ? -1 : 1);
    ivec2 candidates[4] = ivec2[](quad, quad + ivec2(toward.x, 0), quad + ivec2(0, toward.y), quad + toward);

    int axis = normalIndex >> 1;
    for (int i = 0; i < 4; i++) {
        ivec2 q = candidates[i];
        if (q.x < 0 || q.y < 0 || q.x >= quadDims.x || q.y >= quadDims.y) continue;
        ivec4 key = imageLoad(shadowKey, q);
        if (key.w != normalIndex) continue;
        if (key[axis] != mapPos[axis]) continue; // Different plane (e.g. a step up)
        ivec3 d = abs(key.xyz - mapPos);
        if (max(d.x, max(d.y, d.z)) > 2) continue;
        return imageLoad(shadowValue, q).r;
    }
    return softShadow(mapPos, normal);
}

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = renderSize;
    if (pixel_coords.x >= dims.x || pixel_coords.y >= dims.y) return;

    Ray ray = cameraRay(pixel_coords, dims);

    // Sky, Sun & Moon Logic
    float sunDot = max(dot(ray.dir, sunDir), 0.0);
    float moonDot = max(dot(ray.dir, moonDir), 0.0);
    float horizonMask = smoothstep(-0.2, 0.1, ray.dir.y); // Prevents sun/moon glow through ground

    vec3 sunDisk = vec3(1.0, 0.95, 0.85) * pow(sunDot, 800.0);
    vec3 sunGlow = vec3(1.0, 0.6, 0.25) * pow(sunDot, 32.0) * 0.5;

    vec3 moonDisk = vec3(0.85, 0.9, 1.0) * pow(moonDot, 1200.0);
    vec3 moonGlow = vec3(0.4, 0.5, 0.65) * pow(moonDot, 32.0) * 0.25;

    vec3 finalSky = skyColor + (sunDisk + sunGlow) * horizonMask + (moonDisk + moonGlow) * horizonMask;
    vec4 colorResult = vec4(finalSky, 1.0);

    // Unpack what the trace pass hit
    ivec4 g = imageLoad(gBuffer, pixel_coords);
    ivec3 mapPos = g.xyz;
    int normalIndex = g.w & 7;
    int voxelID = (g.w >> 3) & 255;
    float gridFactor = float((g.w >> 11) & 255) / 255.0;
    bool hit = normalIndex != NO_HIT;

    if (hit) {
        vec3 normal = indexToNormal(normalIndex);
        vec3 albedo = getAlbedo(voxelID, mapPos);
        if (voxelID == SAND_ID) {
            // Wet sand near the waterline is darker
            float distanceInland = -sampleShore(vec2(mapPos.xz) + 0.5).x;
            albedo *= 1.0 - 0.4 * smoothstep(8.0, 1.0, distanceInland) * step(0.0, distanceInland);
        }

        // Diffuse Lighting
        float diff = max(dot(normal, lightDir), 0.0);
        float shadow = lookupShadow(pixel_coords, mapPos, normalIndex, normal);

        // Specular (Blinn-Phong)
        vec3 viewDir = normalize(cameraPos - (vec3(mapPos) / float(dimX)));
        vec3 halfwayDir = normalize(lightDir + viewDir);
        float spec = pow(max(dot(normal, halfwayDir), 0.0), 1.0);
        vec3 specular = lightColor * spec * shadow * 0.1;

        // Ambient Occlusion
        float ao = 1.0;
        if (getVoxelVal(mapPos + ivec3(normal)) > 0.0) ao = 0.5;

        vec3 diffuseComponent = albedo * diff * lightColor * shadow;
        vec3 ambientComponent = albedo * ambient;
        vec3 lighting = (diffuseComponent + ambientComponent) * ao + specular;

        // --- WATER: rippling surface, sky reflection and glints ---
        if (voxelID == WATER_ID) {
            // Exact hit point on the face (in voxels), so ripples are smooth inside a voxel
            vec3 originVox = cameraPos * float(dimX);
            int axis = normalIndex >> 1;
            float plane = float(mapPos[axis]) + (normal[axis] > 0.0 ? 1.0 : 0.0);
            vec2 p = (originVox + ray.dir * ((plane - originVox[axis]) / ray.dir[axis])).xz;

            // Surface normal from the FFT slopes (top faces; side faces of wave steps keep
            // their voxel normal), and foam where the choppy displacement folds the surface
            // (Jacobian of the horizontal displacement below ~0.85)
            vec3 n = normal;
            float foam = 0.0;
            if (normalIndex == 2) {
                vec4 slope = sampleOcean(oceanSlope, p);
                vec4 displacement = sampleOcean(oceanDisplacement, p);
                vec4 shore = sampleShore(p);
                float openSea = openSeaFactor(shore);
                float strength = surfStrength(p);

                // Breaker slope along the inland direction (the distance to land falls inland)
                float surfSlope = (surfHeight(shore.x + 0.5, strength) - surfHeight(shore.x - 0.5, strength));
                vec2 shadingSlope = sampleOceanSlopeForShading(p).xy * openSea - shore.zw * surfSlope;
                n = normalize(vec3(-shadingSlope.x, 1.0, -shadingSlope.y));
                float jxx = 1.0 + oceanChoppiness * slope.z;
                float jzz = 1.0 + oceanChoppiness * slope.w;
                float jxz = oceanChoppiness * displacement.w;
                float jacobian = jxx * jzz - jxz * jxz;
                foam = clamp((0.85 - jacobian) * 2.5, 0.0, 1.0) * openSea;
                foam = max(foam, smoothstep(1.3, 2.2, displacement.z * openSea) * 0.6); // Whitecaps on the highest crests

                // Surf: breaking crests, a churning line at the waterline, and the swash itself
                foam = max(foam, smoothstep(14.0, 3.0, shore.x) * clamp(surfHeight(shore.x, strength), 0.0, 1.0));
                float churn = valueNoise(p * 0.5 + vec2(time * 0.8, -time * 0.6));
                foam = max(foam, smoothstep(3.0, 0.5, shore.x) * (0.45 + 0.45 * churn));
                if (shore.x < 0.0) foam = max(foam, 0.75);
            }

            // More reflection at grazing angles (Fresnel), with a glint of the sun or moon
            float fresnel = 0.15 + 0.85 * pow(1.0 - max(dot(n, -ray.dir), 0.0), 4.0);
            vec3 reflected = reflect(ray.dir, n);
            vec3 reflection = skyColor + lightColor * pow(max(dot(reflected, lightDir), 0.0), 200.0) * 3.0 * shadow;

            // Body color, brighter on wave crests (light through thin water)
            float crest = clamp(oceanHeight(p) * 0.5 + 0.5, 0.0, 1.0);
            vec3 body = albedo * (0.8 + 0.5 * crest) * (ambient + max(dot(n, lightDir), 0.0) * lightColor * shadow * 0.8);

            vec3 water = mix(body, reflection, fresnel);
            vec3 foamColor = vec3(0.85, 0.9, 0.92) * (ambient + lightColor * shadow * 0.8);
            lighting = mix(water, foamColor, foam);
        }

        // --- LIT WINDOWS AT NIGHT ---
        if (voxelID == WINDOW_GLASS_ID) {
            float night = clamp(1.0 - dot(lightColor, vec3(0.45)) * 1.6, 0.0, 1.0);
            lighting = mix(lighting, vec3(1.0, 0.72, 0.38), night * 0.85);
        }

        // --- BIOLUMINESCENT CAVE GLOW ---
        if (voxelID == 30) {
            lighting = mix(lighting, vec3(0.0, 1.0, 0.8), 0.75); // Cyan emission
        }

        if (lightVisualizerEnabled == 1) {
            float intensity = clamp((diff * shadow * 0.8 + ambient * ao), 0.0, 1.0);
            float level = floor(intensity * 15.0);
            colorResult.rgb = getFalseColor(level);
        } else {
            colorResult.rgb = lighting;
        }
    }

    // Tile overlay on the ground's top faces
    if (hit && normalIndex == 2 && mapPos.y == overlayGroundY - 1) {
        ivec2 worldTile = ivec2(floor(vec2(mapPos.xz) / float(overlayTileSize)));
        ivec2 tile = worldTile - overlayOrigin;
        if (all(greaterThanEqual(tile, ivec2(0))) && all(lessThan(tile, ivec2(TILE_OVERLAY_SIZE)))) {
            vec4 overlay = tileOverlayColor(texelFetch(tileOverlay, tile, 0).r);
            // Thin darker tile borders make single tiles readable
            ivec2 inTile = mapPos.xz - worldTile * overlayTileSize;
            bool border = inTile.x == 0 || inTile.y == 0;
            colorResult.rgb = mix(colorResult.rgb, overlay.rgb * (border ? 0.7 : 1.0), overlay.a);
        }
    }

    // Build preview: tint the voxels inside the box (and the ground under it), then draw the box
    // itself as a translucent volume with bright edges
    if (previewState != 0) {
        vec3 previewColor = previewState == 1 ? vec3(0.2, 1.0, 0.3) : (previewState == 2 ? vec3(1.0, 0.25, 0.2) : vec3(1.0, 0.85, 0.2));
        if (hit && all(greaterThanEqual(mapPos, previewMin - ivec3(0, 1, 0))) && all(lessThan(mapPos, previewMax))) {
            colorResult.rgb = mix(colorResult.rgb, previewColor, 0.35);
        }

        vec3 originVox = cameraPos * float(dimX);
        float hitT = 1e30;
        if (hit) {
            int axis = normalIndex >> 1;
            float plane = float(mapPos[axis]) + (indexToNormal(normalIndex)[axis] > 0.0 ? 1.0 : 0.0);
            hitT = (plane - originVox[axis]) / ray.dir[axis];
        }
        vec3 inverseDir = 1.0 / ray.dir;
        vec3 t0 = (vec3(previewMin) - originVox) * inverseDir;
        vec3 t1 = (vec3(previewMax) - originVox) * inverseDir;
        vec3 tNear = min(t0, t1), tFar = max(t0, t1);
        float tEnter = max(max(tNear.x, tNear.y), tNear.z);
        float tExit = min(min(tFar.x, tFar.y), tFar.z);
        if (tExit > max(tEnter, 0.0) && tEnter > 0.0 && tEnter < hitT) {
            float edgeWidth = max(0.12, tEnter * 0.0015); // Voxels; about a pixel wide at any distance
            float blend = 0.12;
            // An edge is where the entry (or visible exit) point is near the box boundary on two axes
            for (int side = 0; side < 2; side++) {
                float t = side == 0 ? tEnter : tExit;
                if (t >= hitT) continue;
                vec3 p = originVox + ray.dir * t;
                vec3 d = min(abs(p - vec3(previewMin)), abs(p - vec3(previewMax)));
                int nearAxes = int(d.x < edgeWidth) + int(d.y < edgeWidth) + int(d.z < edgeWidth);
                if (nearAxes >= 2) blend = 0.85;
            }
            colorResult.rgb = mix(colorResult.rgb, previewColor, blend);
        }
    }

    // Blend wireframe chunk edges if enabled
    if (chunkViewerEnabled == 1) {
        colorResult.rgb = mix(colorResult.rgb, vec3(0.0, 1.0, 0.1), gridFactor);
    }

    imageStore(imgOutput, pixel_coords, colorResult);
}
