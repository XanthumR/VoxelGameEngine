#version 440 core
// Wind-swept grass around the player. Each plant is a tuft of 3 voxel blades whose tips bend with a wind wave
// that travels across the field. Runs twice per frame (see GrassAnimator, src/Rendering/GrassAnimator.cpp):
//   mode 0 (update): plants whose pose changed erase their old pose and store the new one
//   mode 1 (draw):   every plant draws its current pose
// Drawing every frame after all erases means a blade wrongly erased by an overlapping
// neighbour, or wiped by a CPU chunk re-upload, is restored within the same frame.
// Grass only ever replaces air and only grass is erased, so terrain is never damaged.
layout(local_size_x = 64) in;

#include "include/voxel_write.glsl"

const int GRASS_ID = 34;             // Block::GRASS_TUFT (colored in render/shade.comp)
const float GRASS_VALUE = 34.0 / 255.0;

struct Plant {
    ivec4 posAndPose; // xyz = root (first air voxel above the ground), w = current pose code (-1 = none)
    vec4 params;      // x = phase offset, y = blade variant (0..3), z = 1 if retired, w = unused
};

layout(std430, binding = 3) buffer PlantBuffer {
    Plant plants[];
};

uniform float time;
uniform int numPlants;
uniform int mode; // 0 = update/erase, 1 = draw
uniform vec2 windDir;

void drawGrass(ivec3 p) {
    ivec3 c, b;
    int pool = locateVoxel(p, c, b);
    if (pool < 0) return;
    float v = loadVoxel(pool, c);
    if (v == 0.0) {
        storeVoxel(pool, c, GRASS_VALUE);
        markBrick(pool, b);
    } else if (voxelId(v) == GRASS_ID) {
        markBrick(pool, b); // Already grass (e.g. a neighbour's blade); keep its brick marked
    }
}

void eraseGrass(ivec3 p) {
    ivec3 c, b;
    int pool = locateVoxel(p, c, b);
    if (pool < 0) return;
    if (voxelId(loadVoxel(pool, c)) == GRASS_ID) storeVoxel(pool, c, 0.0);
}

// Pose code packs the tip offset (x, z), each in [-3, 3]
int encodePose(ivec2 tip) { return (tip.x + 8) | ((tip.y + 8) << 4); }
ivec2 decodePose(int code) { return ivec2((code & 15) - 8, ((code >> 4) & 15) - 8); }

// Blades of each variant: xy = base offset on the ground (x, z), z = height in voxels.
// Must match GRASS_BLADE_SHAPES in src/World/GrassTufts.h, which bakes the rest pose into the terrain.
const ivec3 BLADES[12] = ivec3[](
    ivec3(0, 0, 4), ivec3(1, 1, 3), ivec3(-1, 1, 2),    // Variant 0
    ivec3(0, 0, 3), ivec3(-1, 0, 4), ivec3(1, -1, 2),   // Variant 1
    ivec3(0, 0, 4), ivec3(1, 0, 2), ivec3(0, -1, 3),    // Variant 2
    ivec3(0, 0, 3), ivec3(0, 1, 3), ivec3(-1, -1, 2)    // Variant 3
);

// Visits every voxel of a pose; the base never moves and the bend grows with height
#define FOR_EACH_POSE_VOXEL(root, variant, tip, ACTION)                                  \
    for (int bl = 0; bl < 3; bl++) {                                                     \
        ivec3 blade = BLADES[(variant) * 3 + bl];                                        \
        for (int lv = 0; lv < blade.z; lv++) {                                           \
            float bend = blade.z > 1 ? float(lv) / float(blade.z - 1) : 0.0;             \
            ivec2 off = ivec2(round(vec2(tip) * bend * bend));                           \
            ACTION((root) + ivec3(blade.x + off.x, lv, blade.y + off.y));                \
        }                                                                                \
    }

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(numPlants)) return;

    ivec3 root = plants[idx].posAndPose.xyz;
    int variant = int(plants[idx].params.y) & 3;

    if (mode == 0) {
        // Wind: a wave travelling along windDir, plus a slower gust, quantized to whole voxels
        float along = dot(vec2(root.xz), windDir);
        float wave = sin(time * 1.7 - along * 0.15 + plants[idx].params.x)
                   + 0.5 * sin(time * 0.6 - along * 0.04);
        ivec2 tip = ivec2(round(windDir * clamp(wave, -1.5, 1.5) * 2.0));
        // Retired tufts (left the animation radius) settle back into the rest pose baked in the terrain
        if (plants[idx].params.z != 0.0) tip = ivec2(0);
        int newPose = encodePose(tip);

        int oldPose = plants[idx].posAndPose.w;
        if (newPose != oldPose) {
            if (oldPose >= 0) {
                ivec2 oldTip = decodePose(oldPose);
                FOR_EACH_POSE_VOXEL(root, variant, oldTip, eraseGrass)
            }
            plants[idx].posAndPose.w = newPose;
        }
    } else {
        int pose = plants[idx].posAndPose.w;
        if (pose < 0) return;
        ivec2 tip = decodePose(pose);
        FOR_EACH_POSE_VOXEL(root, variant, tip, drawGrass)
    }
}
