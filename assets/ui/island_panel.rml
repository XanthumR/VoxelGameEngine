<rml>
<head>
    <title>Island</title>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* The island's details, under the island bar */
        body { position: absolute; top: 60dp; left: 492dp; width: 300dp; }
        .title { display: flex; flex-direction: row; align-items: center; }
        .title button.close { padding: 0 6dp; font-size: 13dp; }
    </style>
</head>
<body class="panel" data-model="island_panel">
    <div class="title"><span>{{title}}</span><span class="spacer"/><button class="close" data-event-click="close"><span>X</span></button></div>
    <div class="line" data-for="line : lines">
        <div class="row">
            <img class="icon small" data-if="line.icon != ''" data-attr-src="line.icon"/>
            <span data-class-good="line.tone == 1" data-class-warn="line.tone == 2" data-class-bad="line.tone == 3"
                  data-class-muted="line.tone == 4" data-class-heading="line.tone == 5">{{line.text}}</span>
            <span class="spacer"/>
            <span class="value" data-if="line.value != ''">{{line.value}}</span>
        </div>
        <progress data-if="line.bar >= 0" data-attr-value="line.bar" data-class-warn="line.bar < 0.9" data-class-bad="line.bar < 0.5"/>
    </div>
</body>
</rml>
