/* The game UI's look, shared by every document, after Anno 1800's: dark slate panels with a fine
   gold frame, titles in Roman capitals (Cinzel), text in a book serif (Libre Baskerville), gold for
   what matters, dark buttons rimmed in gold. Sizes are in dp so the UI scales with the display. */

/* RmlUi has no built-in styles: block elements first */
body, div, p, h1, h2, h3, header, footer, section { display: block; }
body {
    font-family: "Libre Baskerville";
    font-size: 13dp;
    color: #e8dfca;
}
h1, h2, h3 { font-family: Cinzel; font-weight: bold; color: #dcbc6e; }
h1 { font-size: 24dp; }
h2 { font-size: 18dp; margin-bottom: 4dp; }
h3 { font-size: 14dp; margin: 8dp 0 3dp; }
p { margin-bottom: 6dp; }
strong { font-weight: bold; }

/* --- Panels: slate, a gold hairline, an inner bevel and a soft shadow --- */
.panel {
    padding: 10dp 14dp 12dp;
    border: 1dp #a8874a;
    border-radius: 3dp;
    decorator: linear-gradient(to bottom, #2b333dF2, #1a1f26F2);
    box-shadow: #00000099 0 8dp 22dp, #f0d89a1a 0 1dp 0 0 inset, #0b0e12 0 0 0 3dp inset, #a8874a66 0 0 0 4dp inset;
}
/* The title: gold Roman capitals on a darker band with a gold rule under it */
.panel .title {
    margin: -10dp -14dp 10dp;
    padding: 7dp 14dp 6dp;
    font-family: Cinzel;
    font-weight: bold;
    font-size: 16dp;
    color: #e2c275;
    decorator: linear-gradient(to bottom, #151a20, #0f1317);
    border-bottom: 1dp #a8874a;
}
.separator { height: 1dp; margin: 8dp 0; decorator: linear-gradient(to right, #a8874a00, #a8874a, #a8874a00); }

/* --- Text --- */
.muted { color: #9c9584; }
.good { color: #9bcf6a; }
.warn { color: #e8b04a; }
.bad { color: #ec6b55; }
.value { font-weight: bold; color: #f1e7cf; }

/* --- Rows of things side by side --- */
.row { display: flex; flex-direction: row; align-items: center; }
.row > * { margin-right: 8dp; }
.row > *:last-child { margin-right: 0; }
.spacer { flex: 1; }

/* --- Icons (64 px pixel art, shown at half or a quarter size so the pixels stay even) --- */
img.icon { width: 32dp; height: 32dp; }
img.icon.small { width: 16dp; height: 16dp; }
.good-amount { display: inline-flex; flex-direction: row; align-items: center; margin-right: 10dp; }
.good-amount img { margin-right: 3dp; }

/* --- Buttons: dark, rimmed in gold, lit on hover --- */
button {
    display: inline-block;
    padding: 5dp 12dp;
    text-align: center;
    white-space: nowrap;
    font-family: Cinzel;
    font-weight: bold;
    font-size: 13dp;
    color: #e8dfca;
    border: 1dp #a8874a;
    border-radius: 2dp;
    decorator: linear-gradient(to bottom, #3a4552, #232a33);
    box-shadow: #ffffff14 0 1dp 0 0 inset;
    cursor: pointer;
}
button:hover { decorator: linear-gradient(to bottom, #4a5767, #2c3540); color: #fff3d6; border-color: #e2c275; }
button:active { decorator: linear-gradient(to bottom, #1b2027, #2a323c); }
/* A toggle that is on (the game speed in use, an open window), and the main action */
button.selected, button.primary { color: #1e1a12; border-color: #f0d89a; decorator: linear-gradient(to bottom, #e9c97c, #b38b3e); }
button.primary:hover { decorator: linear-gradient(to bottom, #f3d68e, #c39a48); }
button:disabled, button[disabled], button.disabled {
    color: #6f6c66;
    border-color: #4a4538;
    decorator: linear-gradient(to bottom, #2a2f36, #1e2228);
    cursor: unavailable;
}

/* Load / unload toggles (trade routes) */
button.load { color: #f1f7e8; border-color: #8fc76a; decorator: linear-gradient(to bottom, #4c7a35, #2f5321); }
button.unload { color: #fff4e0; border-color: #e8b04a; decorator: linear-gradient(to bottom, #9a6a1c, #6b4510); }

/* --- Tabs: dark plaques, the open one gold --- */
.tabs { display: flex; flex-direction: row; margin-bottom: 8dp; }
.tab {
    flex: 1;
    padding: 5dp 8dp;
    margin-right: 4dp;
    text-align: center;
    white-space: nowrap;
    font-family: Cinzel;
    font-weight: bold;
    font-size: 13dp;
    color: #cfc4ab;
    border: 1dp #6e5a33;
    border-radius: 2dp;
    decorator: linear-gradient(to bottom, #2b333d, #1a1f26);
    cursor: pointer;
}
.tab:last-child { margin-right: 0; }
.tab:hover { color: #fff3d6; border-color: #e2c275; }
.tab.selected { color: #1e1a12; border-color: #f0d89a; decorator: linear-gradient(to bottom, #e9c97c, #b38b3e); }

/* --- Bars: need supply, productivity, cycle progress --- */
progress {
    display: block;
    width: 100%;
    height: 8dp;
    border: 1dp #5d4b2a;
    border-radius: 1dp;
    background-color: #0b0e12;
}
progress fill { decorator: linear-gradient(to bottom, #a6d66f, #5f9a36); }
progress.warn fill { decorator: linear-gradient(to bottom, #f2c35d, #b9842a); }
progress.bad fill { decorator: linear-gradient(to bottom, #f07b62, #a63a26); }

/* --- Info rows (InfoLines): icon, text, a value on the right, maybe a bar --- */
.line { margin-bottom: 4dp; }
.line .row > * { margin-right: 6dp; }
.line .heading { font-family: Cinzel; font-weight: bold; color: #dcbc6e; }
.line progress { height: 5dp; margin-top: 2dp; margin-bottom: 2dp; }
/* A smaller panel (tooltips) */
.panel.compact { padding: 6dp 10dp 8dp; font-size: 12dp; }
.panel.compact .title { margin: -6dp -10dp 6dp; padding: 5dp 10dp 4dp; font-size: 14dp; }

/* --- Scrollbars (RmlUi draws only styled ones): a gold bar in a dark track --- */
scrollbarvertical { width: 8dp; margin-left: 4dp; }
scrollbarvertical slidertrack { background-color: #0b0e12; border-radius: 3dp; }
scrollbarvertical sliderbar { background-color: #8a6f3c; border-radius: 3dp; }
scrollbarvertical sliderbar:hover { background-color: #c9a55a; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0; height: 0; }

/* --- Tooltips: a small dark card near the cursor --- */
.tooltip {
    padding: 6dp 10dp;
    font-size: 12dp;
    color: #e8dfca;
    background-color: #12161bF2;
    border: 1dp #a8874a;
    border-radius: 2dp;
    box-shadow: #00000099 0 4dp 12dp;
}
.tooltip .muted { color: #9c9584; }
