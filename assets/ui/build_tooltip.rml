<rml>
<head>
    <title>Building card</title>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* Above the hovered card of the construction menu (BuildMenu places it); it never takes the mouse */
        body { position: absolute; width: 330dp; pointer-events: none; z-index: 100; }
    </style>
</head>
<body class="panel compact" data-model="build_tooltip">
    <div class="title">{{title}}</div>
    <div class="line" data-for="line : lines">
        <div class="row">
            <img class="icon small" data-if="line.icon != ''" data-attr-src="line.icon"/>
            <span data-class-good="line.tone == 1" data-class-warn="line.tone == 2" data-class-bad="line.tone == 3"
                  data-class-muted="line.tone == 4" data-class-heading="line.tone == 5">{{line.text}}</span>
            <span class="spacer"/>
            <span class="value" data-if="line.value != ''">{{line.value}}</span>
        </div>
    </div>
</body>
</rml>
