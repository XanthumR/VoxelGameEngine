<rml>
<head>
    <title>Style sample</title>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* Placement of this sample only */
        body { position: absolute; left: 24dp; bottom: 24dp; width: 440dp; }
        #tooltip-sample { margin-top: 8dp; }
    </style>
</head>
<body class="panel">
    <div class="title">Style sample</div>
    <h2>Island storage</h2>
    <div class="row">
        <span class="good-amount"><img class="icon" src="icons/wood.tga"/><span class="value">24</span></span>
        <span class="good-amount"><img class="icon" src="icons/planks.tga"/><span class="value">30</span></span>
        <span class="good-amount"><img class="icon" src="icons/fish.tga"/><span class="value">12</span></span>
        <span class="good-amount"><img class="icon" src="icons/wool.tga"/><span class="value">0</span></span>
    </div>
    <div class="row">
        <span class="good-amount"><img class="icon" src="icons/work_clothes.tga"/><span class="value">5</span></span>
        <span class="good-amount"><img class="icon" src="icons/bricks.tga"/><span class="value">8</span></span>
        <span class="good-amount"><img class="icon" src="icons/sausages.tga"/><span class="value">3</span></span>
        <span class="good-amount"><img class="icon" src="icons/pigs.tga"/><span class="value">6</span></span>
    </div>
    <div class="separator"/>
    <div class="tabs">
        <div class="tab selected">Housing</div>
        <div class="tab">Production</div>
        <div class="tab">Infrastructure</div>
    </div>
    <h3>Needs of the farmers</h3>
    <div class="row"><img class="icon small" src="icons/fish.tga"/><span>Fish</span><span class="spacer"/><span class="good">100%</span></div>
    <progress value="1"/>
    <div class="row"><img class="icon small" src="icons/work_clothes.tga"/><span>Work clothes</span><span class="spacer"/><span class="warn">55%</span></div>
    <progress class="warn" value="0.55"/>
    <div class="row"><img class="icon small" src="icons/warning.tga"/><span class="bad">No road to a warehouse</span></div>
    <div class="separator"/>
    <div class="row">
        <img class="icon small" src="icons/coin.tga"/><span class="value">3000</span><span class="muted">+24 / min</span>
        <span class="spacer"/>
        <img class="icon small" src="icons/farmer.tga"/><img class="icon small" src="icons/worker.tga"/>
        <img class="icon small" src="icons/residents.tga"/><img class="icon small" src="icons/upgrade.tga"/>
        <img class="icon small" src="icons/ship.tga"/>
    </div>
    <div class="separator"/>
    <div class="row">
        <button>Build ship</button>
        <button class="primary">Upgrade</button>
        <button disabled>Not enough coins</button>
    </div>
    <div id="tooltip-sample" class="tooltip">Farmer House <span class="muted">50 coins, 2 planks</span></div>
</body>
</rml>
