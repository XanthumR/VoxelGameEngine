<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{6f1c2d6e-3b8a-4c57-9a43-2e7d5b9c41a0}</ProjectGuid>
    <RootNamespace>VoxelAnnoTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Label="UserMacros">
    <!-- Same GLFW folder as the game (it also holds glm); override with /p:GlfwDir=... -->
    <GlfwDir Condition="'$(GlfwDir)'==''">C:\Users\Gaming\Documents\Libraries\glfw-3.4.bin.WIN64</GlfwDir>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <GoogleTestTargets>$(RepoRoot)packages\Microsoft.googletest.v140.windesktop.msvcstl.static.rt-dyn.1.8.1.7\build\native\Microsoft.googletest.v140.windesktop.msvcstl.static.rt-dyn.targets</GoogleTestTargets>
  </PropertyGroup>
  <PropertyGroup>
    <!-- x64\Debug\VoxelAnnoTests.exe next to the game -->
    <OutDir>$(RepoRoot)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RepoRoot)$(Platform)\$(Configuration)\VoxelAnnoTests\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- gtest, glm and other <angle> includes are third-party: no warnings from them -->
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(RepoRoot)src;$(GlfwDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Building model tests load the real assets -->
      <PreprocessorDefinitions>_CONSOLE;ASSET_DIRECTORY="$(RepoRoot.Replace('\', '/'))assets";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- The game's pure-logic sources (no OpenGL, no window) -->
  <ItemGroup>
    <ClCompile Include="..\src\Economy\IslandEconomy.cpp" />
    <ClCompile Include="..\src\Economy\PopulationNeeds.cpp" />
    <ClCompile Include="..\src\Economy\PopulationSystem.cpp" />
    <ClCompile Include="..\src\Economy\Production.cpp" />
    <ClCompile Include="..\src\Economy\Treasury.cpp" />
    <ClCompile Include="..\src\Gameplay\Carts.cpp" />
    <ClCompile Include="..\src\Gameplay\FigureModels.cpp" />
    <ClCompile Include="..\src\Gameplay\FishingBoats.cpp" />
    <ClCompile Include="..\src\Gameplay\Smoke.cpp" />
    <ClCompile Include="..\src\Gameplay\Walkers.cpp" />
    <ClCompile Include="..\src\Simulation\BuildingLook.cpp" />
    <ClCompile Include="..\src\Simulation\BuildingModels.cpp" />
    <ClCompile Include="..\src\Simulation\GameClock.cpp" />
    <ClCompile Include="..\src\Simulation\GameObjects.cpp" />
    <ClCompile Include="..\src\Simulation\IslandRegistry.cpp" />
    <ClCompile Include="..\src\Simulation\Logistics.cpp" />
    <ClCompile Include="..\src\Simulation\OccupancyGrid.cpp" />
    <ClCompile Include="..\src\Simulation\Placement.cpp" />
    <ClCompile Include="..\src\Simulation\ProducerLocation.cpp" />
    <ClCompile Include="..\src\Simulation\RoadNetwork.cpp" />
    <ClCompile Include="..\src\Simulation\Simulation.cpp" />
    <ClCompile Include="..\src\Simulation\TreeRegistry.cpp" />
    <ClCompile Include="..\src\World\BuildingModel.cpp" />
    <ClCompile Include="..\src\World\TerrainGenerator.cpp" />
    <ClCompile Include="..\src\World\VoxModel.cpp" />
    <ClCompile Include="..\src\World\VoxelWorld.cpp" />
  </ItemGroup>
  <!-- The tests -->
  <ItemGroup>
    <ClCompile Include="BuildingLookTests.cpp" />
    <ClCompile Include="BuildingModelTests.cpp" />
    <ClCompile Include="CoastAndSmokeTests.cpp" />
    <ClCompile Include="GameClockTests.cpp" />
    <ClCompile Include="GameObjectTests.cpp" />
    <ClCompile Include="IslandEconomyTests.cpp" />
    <ClCompile Include="IslandRegistryTests.cpp" />
    <ClCompile Include="LogisticsTests.cpp" />
    <ClCompile Include="Main.cpp" />
    <ClCompile Include="PlacementTests.cpp" />
    <ClCompile Include="PopulationTests.cpp" />
    <ClCompile Include="ProducerLocationTests.cpp" />
    <ClCompile Include="ProductionTests.cpp" />
    <ClCompile Include="TerrainTests.cpp" />
    <ClCompile Include="TreasuryTests.cpp" />
    <ClCompile Include="RoadNetworkTests.cpp" />
    <ClCompile Include="TestWorld.cpp" />
    <ClCompile Include="WalkerTests.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="TestWorld.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(GoogleTestTargets)" Condition="Exists('$(GoogleTestTargets)')" />
  </ImportGroup>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GoogleTestTargets)')" Text="Google Test package missing. Restore it first: msbuild VoxelGameEngine.sln -t:restore -p:RestorePackagesConfig=true" />
  </Target>
</Project>
